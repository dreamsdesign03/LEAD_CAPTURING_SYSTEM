{
  "name": "01-Capture-Meta-Lead-Ads",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-leads",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "meta-webhook",
      "name": "Meta Lead Ads Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, 0],
      "webhookId": "meta-leads"
    },
    {
      "parameters": {
        "jsCode": "const value = $json.entry?.[0]?.changes?.[0]?.value ?? {};\nconst fieldData = value.field_data ?? [];\nconst get = (n) => fieldData.find((f) => f.name === n)?.values?.[0] || '';\nconst firstName = get('first_name');\nconst lastName = get('last_name');\nconst lead = {\n  name: get('full_name') || [firstName, lastName].filter(Boolean).join(' ') || 'Unknown',\n  email: get('email') || null,\n  phone: get('phone_number') || get('phone') || null,\n  source: 'meta',\n  raw_data: $json\n};\nreturn [{ json: lead }];"
      },
      "id": "meta-map",
      "name": "Map Meta Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, email: $json.email, phone: $json.phone, source: $json.source, raw_data: $json.raw_data }) }}",
        "options": {}
      },
      "id": "meta-insert",
      "name": "Insert Lead Into Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {}
      },
      "id": "meta-respond",
      "name": "Ack Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [580, 0]
    }
  ],
  "connections": {
    "Meta Lead Ads Webhook": {
      "main": [
        [
          {
            "node": "Map Meta Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Meta Fields": {
      "main": [
        [
          {
            "node": "Insert Lead Into Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Lead Into Supabase": {
      "main": [
        [
          {
            "node": "Ack Meta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "lead-capture"
  }
}