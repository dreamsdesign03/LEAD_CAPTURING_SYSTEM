{
  "name": "11-Followup-Reminder-Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "cron": [
            {
              "expression": "*/15 * * * * *"
            }
          ]
        }
      },
      "id": "fu-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-900, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/followups?status=eq.pending&attempt=lte.3&scheduled_at=lte.now&select=id,lead_id,channel,attempt",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fu-get",
      "name": "Get Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.channel }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fu-route",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_URL }}/webhook/outreach-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.lead_id, message_type: 'followup', followup_attempt: ($json.attempt || 0) + 1 }) }}",
        "requestOptions": {
          "timeout": 3000
        },
        "options": {}
      },
      "id": "fu-email",
      "name": "Fire Email Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/followups?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'done' }) }}",
        "options": {}
      },
      "id": "fu-email-done",
      "name": "Mark Email Follow-up Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, -240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_URL }}/webhook/outreach-whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.lead_id, message_type: 'followup', followup_attempt: ($json.attempt || 0) + 1 }) }}",
        "requestOptions": {
          "timeout": 3000
        },
        "options": {}
      },
      "id": "fu-wa",
      "name": "Fire WhatsApp Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/followups?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'done' }) }}",
        "options": {}
      },
      "id": "fu-wa-done",
      "name": "Mark WhatsApp Follow-up Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_URL }}/webhook/outreach-ai-call",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.lead_id, message_type: 'followup', followup_attempt: ($json.attempt || 0) + 1 }) }}",
        "requestOptions": {
          "timeout": 3000
        },
        "options": {}
      },
      "id": "fu-call",
      "name": "Fire AI Call Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/followups?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'done' }) }}",
        "options": {}
      },
      "id": "fu-call-done",
      "name": "Mark AI Call Follow-up Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 240]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Get Due Follow-ups", "type": "main", "index": 0 }]]
    },
    "Get Due Follow-ups": {
      "main": [[{ "node": "Route by Channel", "type": "main", "index": 0 }]]
    },
    "Route by Channel": {
      "main": [
        [{ "node": "Fire Email Follow-up", "type": "main", "index": 0 }],
        [
          { "node": "Fire WhatsApp Follow-up", "type": "main", "index": 0 }
        ],
        [
          { "node": "Fire AI Call Follow-up", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fire Email Follow-up": {
      "main": [[{ "node": "Mark Email Follow-up Done", "type": "main", "index": 0 }]]
    },
    "Fire WhatsApp Follow-up": {
      "main": [[{ "node": "Mark WhatsApp Follow-up Done", "type": "main", "index": 0 }]]
    },
    "Fire AI Call Follow-up": {
      "main": [[{ "node": "Mark AI Call Follow-up Done", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "lead-capture" }
}