{
  "name": "04-Capture-Google-Sheets",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "added",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "options": {}
      },
      "id": "gs-trigger",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 2,
      "position": [-500, 0]
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nconst lead = {\n  name: r.name || r['Full Name'] || r.full_name || 'Unknown',\n  email: r.email || r['Email'] || null,\n  phone: r.phone || r['Phone'] || r['Phone Number'] || null,\n  source: 'google_sheet',\n  raw_data: $json\n};\nreturn [{ json: lead }];"
      },
      "id": "gs-map",
      "name": "Map Sheet Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, email: $json.email, phone: $json.phone, source: $json.source, raw_data: $json.raw_data }) }}",
        "options": {}
      },
      "id": "gs-insert",
      "name": "Insert Lead Into Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [[{ "node": "Map Sheet Row", "type": "main", "index": 0 }]]
    },
    "Map Sheet Row": {
      "main": [[{ "node": "Insert Lead Into Supabase", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "lead-capture" }
}