{
  "name": "05-Capture-WhatsApp-DM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wa-webhook",
      "name": "WhatsApp Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, 0],
      "webhookId": "whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "const from = $json.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.from ?? $json.from ?? $json.wa_id ?? '';\nconst text = $json.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body ?? $json.text ?? '';\nconst name = $json.entry?.[0]?.changes?.[0]?.value?.contacts?.[0]?.profile?.name ?? $json.name ?? 'Unknown';\nconst lead = {\n  name,\n  email: null,\n  phone: from,\n  source: 'whatsapp',\n  raw_data: $json\n};\nreturn [{ json: lead, note: `Inbound: ${text}` }];"
      },
      "id": "wa-map",
      "name": "Map WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?email=null",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, email: $json.email, phone: $json.phone, source: $json.source, raw_data: $json.raw_data, notes: $json.note }) }}",
        "options": {}
      },
      "id": "wa-insert",
      "name": "Insert Lead Into Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"received\"}",
        "options": {}
      },
      "id": "wa-respond",
      "name": "Ack WhatsApp",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [580, 0]
    }
  ],
  "connections": {
    "WhatsApp Inbound Webhook": {
      "main": [[{ "node": "Map WhatsApp Message", "type": "main", "index": 0 }]]
    },
    "Map WhatsApp Message": {
      "main": [[{ "node": "Insert Lead Into Supabase", "type": "main", "index": 0 }]]
    },
    "Insert Lead Into Supabase": {
      "main": [[{ "node": "Ack WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "lead-capture" }
}