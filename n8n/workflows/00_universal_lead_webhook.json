      "parameters": {
        "jsCode": "function deepGet(obj, keys) {\n  if (!obj || typeof obj !== 'object') return undefined;\n  for (const k of Object.keys(obj)) {\n    const kk = k.toLowerCase();\n    for (const target of keys) {\n      if (kk === target || kk.includes(target)) {\n        const v = obj[k];\n        if (v == null) continue;\n        if (Array.isArray(v)) return String(v[0] ?? '').trim();\n        if (typeof v === 'object') {\n          const inner = v.values?.[0] ?? v.value ?? v.text ?? v.label;\n          if (inner != null) return String(inner).trim();\n          continue;\n        }\n        if (typeof v === 'string' || typeof v === 'number') return String(v).trim();\n      }\n    }\n    if (obj[k] && typeof obj[k] === 'object') {\n      const r = deepGet(obj[k], keys);\n      if (r !== undefined) return r;\n    }\n  }\n  return undefined;\n}\n\nfunction findSource(obj) {\n  if (!obj || typeof obj !== 'object') return undefined;\n  for (const k of Object.keys(obj)) {\n    if (k.toLowerCase() === 'source' && typeof obj[k] === 'string') return obj[k].trim().toLowerCase();\n    if (obj[k] && typeof obj[k] === 'object') {\n      const r = findSource(obj[k]);\n      if (r) return r;\n    }\n  }\n  return undefined;\n}\n\nconst first = deepGet($json, ['first_name', 'fname']) || '';\nconst last = deepGet($json, ['last_name', 'lname']) || '';\nconst raw = JSON.stringify($json).toLowerCase();\nconst name = deepGet($json, ['full_name']) || `${first} ${last}`.trim() || deepGet($json, ['name', 'contact_name']) || 'Unknown';\nconst email = (deepGet($json, ['email', 'email_address', 'e-mail', 'mail']) || '').toLowerCase();\nconst phone = deepGet($json, ['phone', 'phone_number', 'mobile', 'whatsapp', 'telephone', 'contact_number', 'customer_phone']) || '';\n\nlet source = findSource($json) || 'manual';\nif (source === 'manual' && (raw.includes('leadgen') || raw.includes('field_data'))) source = 'meta';\nelse if (source === 'manual' && raw.includes('answers') && (raw.includes('fieldlabel') || raw.includes('field_key'))) source = 'linkedin';\nelse if (source === 'manual' && raw.includes('from') && raw.includes('whatsapp')) source = 'whatsapp';\n\nconst hasId = !!(email || phone);\nreturn [{ json: { name, email, phone, source, raw_data: $json, hasId } }];"
      },
