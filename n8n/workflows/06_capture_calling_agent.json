{
  "name": "06-Capture-Calling-Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calling-agent",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "ca-webhook",
      "name": "Calling Agent Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, 0],
      "webhookId": "calling-agent"
    },
    {
      "parameters": {
        "jsCode": "const p = $json;\nconst lead = {\n  name: p.name || p.customer_name || 'Unknown',\n  email: p.email || null,\n  phone: p.phone || p.customer_phone || null,\n  source: 'calling_agent',\n  raw_data: $json\n};\nreturn [{ json: lead }];"
      },
      "id": "ca-map",
      "name": "Map Agent Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, email: $json.email, phone: $json.phone, source: $json.source, raw_data: $json.raw_data }) }}",
        "options": {}
      },
      "id": "ca-insert",
      "name": "Insert Lead Into Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Calling Agent Webhook": {
      "main": [[{ "node": "Map Agent Call Data", "type": "main", "index": 0 }]]
    },
    "Map Agent Call Data": {
      "main": [[{ "node": "Insert Lead Into Supabase", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "lead-capture" }
}