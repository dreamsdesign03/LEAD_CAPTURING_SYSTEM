{
  "name": "08-Outreach-Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "em-webhook",
      "name": "Email Outreach Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-700, 0],
      "webhookId": "outreach-email"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.lead_id }}&select=id,name,email,phone,raw_data",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "em-get",
      "name": "Get Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('Email Outreach Webhook').item.json;\nconst lead = $json[0] ?? $json;\nconst firstName = (lead.name || 'there').split(' ')[0];\nconst isFollowup = webhook.message_type === 'followup';\nconst next_attempt = webhook.followup_attempt || 2;\nconst subject = isFollowup ? `Quick follow-up, ${firstName}` : `Great to connect, ${firstName}`;\nconst body = `<p>Hi ${firstName},</p><p>We noticed you are interested in our solution. Would you like to book a quick 15-minute call to see how it works for your business?</p><p>Just reply to this email or pick a slot.</p><p>Best,<br/>Your Sales Team</p>`;\nreturn [{ json: { lead_id: lead.id, email: lead.email, subject, body, next_attempt } }];"
      },
      "id": "em-build",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "emailType": "html",
        "to": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "em-send",
      "name": "Send via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [320, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "SET_UP_IN_UI",
          "name": "Gmail OAuth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/outreach_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.lead_id, channel: 'email', status: 'sent', message_content: $json.subject + ' :: ' + $json.body }) }}",
        "options": {}
      },
      "id": "em-log",
      "name": "Log Outbound Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.next_attempt }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "em-cap",
      "name": "Another Follow-up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/followups",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.lead_id, channel: 'email', scheduled_at: new Date(Date.now() + ($json.next_attempt === 3 ? 7 : 3) * 24 * 60 * 60 * 1000).toISOString(), status: 'pending', attempt: $json.next_attempt }) }}",
        "options": {}
      },
      "id": "em-followup",
      "name": "Schedule Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 0]
    }
  ],
  "connections": {
    "Email Outreach Webhook": {
      "main": [[{ "node": "Get Lead", "type": "main", "index": 0 }]]
    },
    "Get Lead": {
      "main": [[{ "node": "Build Email", "type": "main", "index": 0 }]]
    },
    "Build Email": {
      "main": [[{ "node": "Send via Gmail", "type": "main", "index": 0 }]]
    },
    "Send via Gmail": {
      "main": [[{ "node": "Log Outbound Email", "type": "main", "index": 0 }]]
    },
    "Log Outbound Email": {
      "main": [[{ "node": "Another Follow-up?", "type": "main", "index": 0 }]]
    },
    "Another Follow-up?": {
      "main": [
        [{ "node": "Schedule Follow-up", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "lead-capture" }
}