    {
      "parameters": {
        "jsCode": "const raw = $json;\nlet value = null;\nif (raw.entry && Array.isArray(raw.entry) && raw.entry[0]?.changes?.[0]?.value) {\n  value = raw.entry[0].changes[0].value;\n} else if (raw.value) {\n  value = raw.value;\n} else {\n  value = raw;\n}\n\nconst messages = value.messages || raw.messages || [raw];\nconst msg = Array.isArray(messages) ? messages[0] : messages;\n\nconst senderPhone = String(msg.from || value.from || raw.from || '').trim();\nconst cleanDigits = senderPhone.replace(/\\D/g, '');\nconst senderName = value.contacts?.[0]?.profile?.name || raw.contacts?.[0]?.profile?.name || raw.profile_name || 'WhatsApp User';\nconst waMessageId = String(msg.id || msg.wamid || raw.wamid || `wamid_${Date.now()}`);\nconst rawTimestamp = msg.timestamp || raw.timestamp;\n\nlet messageText = '';\nif (msg.text?.body) {\n  messageText = msg.text.body;\n} else if (msg.type === 'text' && typeof msg.text === 'string') {\n  messageText = msg.text;\n} else if (msg.interactive) {\n  messageText = msg.interactive?.button_reply?.title || msg.interactive?.list_reply?.title || '[Interactive Reply]';\n} else if (msg.button) {\n  messageText = msg.button?.text || '[Button Click]';\n} else if (typeof msg.body === 'string') {\n  messageText = msg.body;\n} else {\n  messageText = msg.text?.body || `[${msg.type || 'Media'} Message]`;\n}\n\nconst sentAt = rawTimestamp \n  ? new Date(typeof rawTimestamp === 'number' ? rawTimestamp * 1000 : parseInt(rawTimestamp, 10) * 1000).toISOString()\n  : new Date().toISOString();\n\nreturn [{\n  json: {\n    senderPhone,\n    cleanDigits,\n    senderName,\n    messageText,\n    waMessageId,\n    sentAt,\n    rawPayload: raw\n  }\n}];"
      },
