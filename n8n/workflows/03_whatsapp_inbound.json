      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1120, -448]
    },
    {
      "parameters": {
        "jsCode": "const entry = $json.entry?.[0];\nconst value = entry?.changes?.find(c => c.field === 'messages')?.value;\nif (!value) return [];\nconst msg = value.messages?.[0];\nif (!msg || msg.type === 'unknown') return [];\nconst text =\n  msg.text?.body\n  || msg.interactive?.button_reply?.title\n  || msg.interactive?.list_reply?.title\n  || msg.image?.caption\n  || '';\nreturn [{\n  json: {\n    sender_phone: String(msg.from || '').replace(/^\\+/,''),\n    message_text: String(text).trim(),\n    message_type: msg.type || 'text',\n    wa_message_id: msg.id || null,\n    sent_at: new Date(Number(msg.timestamp) * 1000).toISOString(),\n    sender_name: value.contacts?.[0]?.profile?.name || ''\n  }\n}];"
      },
      "id": "wa-parse-meta",
      "name": "Parse Meta Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
