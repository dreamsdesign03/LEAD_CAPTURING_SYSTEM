    {
      "parameters": {
        "jsCode": "const p = $('Parse Meta Message').item.json;\nconst last10 = String(p.sender_phone).slice(-10);\nconst name = p.sender_name || ('WhatsApp ' + last10);\nreturn [{ json: { name, phone: '+' + String(p.sender_phone), source: 'whatsapp' } }];"
      },
