      "name": "Forward to Aura AI1"
    },
    {
      "parameters": {
        "jsCode": "const root = $json;\nconst value = root?.entry?.[0]?.changes?.find((c) => c.field === 'messages')?.value || root;\nconst msg = Array.isArray(value?.messages) ? value.messages[0] : null;\nif (!msg || msg.type === 'unknown') return [];\nconst text =\n  msg.text?.body\n  || msg.interactive?.button_reply?.title\n  || msg.interactive?.list_reply?.title\n  || msg.image?.caption\n  || msg.document?.filename\n  || '';\nreturn [{\n  json: {\n    sender_phone: String(msg.from || '').replace(/^\\+/,''),\n    message_text: String(text).trim(),\n    message_type: msg.type || 'text',\n    wa_message_id: msg.id || null,\n    sent_at: msg.timestamp\n      ? new Date(Number(msg.timestamp) * 1000).toISOString()\n      : new Date().toISOString(),\n    sender_name: value?.contacts?.[0]?.profile?.name || ''\n  }\n}];"
      },
