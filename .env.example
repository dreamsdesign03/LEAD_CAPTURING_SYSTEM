# Environment variables (copy to .env in the Vite project root for the dashboard, and as n8n env vars on your n8n instance)

# ---- Supabase ----
# https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- n8n (set these as ENVIRONMENT VARIABLES on the n8n server / instance) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
N8N_URL=https://your-n8n-public-url
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
QUALIFY_THRESHOLD=70
# Gemini API key used by the AI qualifier (x-goog-api-key header)
GEMINI_API_KEY=your-gemini-api-key

# ---- WhatsApp Business Cloud API (if using native n8n node, set in credential instead) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Shared secret for the Meta webhook GET verification handshake (must match what you enter in Meta's
# "WhatsApp -> Configuration -> Webhook" for the n8n inbound webhook)
WHATSAPP_VERIFY_TOKEN=lead_capture_secure_verify_token
# Approved Meta template name used for hot/warm welcome message (e.g. lead_welcome)
WHATSAPP_TEMPLATE_NAME=lead_welcome
# Approved Meta template used by the reminder workflow (defaults to the booking template)
WHATSAPP_REMINDER_TEMPLATE_NAME=mansi_lead_demo_appointment_booking

# ---- Chat inbox UI (frontend -> n8n reply webhook) ----
# Public n8n webhook URL for the "send-whatsapp-reply" workflow (workflow 04)
VITE_WHATSAPP_SEND_URL=https://your-n8n-public-url/webhook/send-whatsapp-reply
# Optional: the business WhatsApp number shown in the inbox header (digits only, e.g. 918866351852)
VITE_WHATSAPP_BIZ_NUMBER=

# ---- Vapi.ai (AI outbound calls) ----
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=